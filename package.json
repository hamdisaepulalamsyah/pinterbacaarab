{
  "name": "pinterbacaarab",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "pnpm --filter \"@pinterbacaarab/*\" run build",
    "lint": "prettier --check \"**/*.{ts,tsx,js,json,md}\"",
    "typecheck": "pnpm --filter \"@pinterbacaarab/*\" run typecheck",
    "test": "pnpm --filter \"@pinterbacaarab/*\" run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "llm:smoke": "tsx apps/worker/src/smoke.ts"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "@types/node": "^22.13.0",
    "dotenv": "^18.0.9",
    "prettier": "^3.5.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "vitest": "^5.0.5"
  }
}
